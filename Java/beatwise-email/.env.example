# Copie este arquivo para ".env" (mesma pasta) e preencha. O ".env" nunca vai para o Git.

# Banco: o MESMO banco que o sistema Node usa (é por ele que os dois se comunicam)
DB_URL=jdbc:mysql://localhost:3306/beatwise
DB_USER=
DB_PASSWORD=

# Conta que envia os e-mails (Gmail) e a SENHA DE APP dela, sem espaços
EMAIL=
EMAIL_PASSWORD=

# Endereço onde o sistema Node roda; é o que vai no link do e-mail
APP_URL=http://localhost:3333

